# Environment Variables

# Turso database URL (format: libsql://your-db-name-username.turso.io)
TURSO_DATABASE_URL="libsql://your-db-name-username.turso.io"

# Turso auth token (dari: turso db tokens create nama-db)
TURSO_AUTH_TOKEN="your-auth-token-here"

# JWT Secret untuk autentikasi (generate random string panjang)
JWT_SECRET="your-super-secret-jwt-key-here"
